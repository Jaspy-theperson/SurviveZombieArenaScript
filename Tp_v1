    co.BackgroundTransparency = 1
    co.Text = string.format("%.1f, %.1f, %.1f", w.x, w.y, w.z)
    co.TextColor3 = Color3.fromRGB(140, 160, 200)
    co.TextSize = 11
    co.Font = Enum.Font.Code
    co.TextXAlignment = Enum.TextXAlignment.Left
    co.Parent = r

    local tpb = Instance.new("TextButton")
    tpb.Size = UDim2.new(0, 32, 0, 32)
    tpb.Position = UDim2.new(1, -74, 0, 4)
    tpb.BackgroundColor3 = Color3.fromRGB(60, 100, 180)
    tpb.Text = "▶"
    tpb.TextColor3 = Color3.fromRGB(255, 255, 255)
    tpb.TextSize = 16
    tpb.Font = Enum.Font.GothamBold
    tpb.Parent = r
    local tpbc = Instance.new("UICorner", tpb)
    tpbc.CornerRadius = UDim.new(0, 6)
    tpb.MouseButton1Click:Connect(function()
        tp(Vector3.new(w.x, w.y, w.z))
    end)

    local db = Instance.new("TextButton")
    db.Size = UDim2.new(0, 32, 0, 32)
    db.Position = UDim2.new(1, -38, 0, 4)
    db.BackgroundColor3 = Color3.fromRGB(140, 50, 50)
    db.Text = "✕"
    db.TextColor3 = Color3.fromRGB(255, 255, 255)
    db.TextSize = 14
    db.Font = Enum.Font.GothamBold
    db.Parent = r
    local dbc = Instance.new("UICorner", db)
    dbc.CornerRadius = UDim.new(0, 6)
    db.MouseButton1Click:Connect(function()
        table.remove(W, i)
        saveW()
        _G.refreshWaypoints()
    end)
end

function _G.refreshWaypoints()
    for _, ch in ipairs(sc:GetChildren()) do
        if ch:IsA("Frame") then ch:Destroy() end
    end
    for i, w in ipairs(W) do createWaypointRow(w, i) end
end

svb.MouseButton1Click:Connect(function()
    local ch = player.Character
    if not ch then return end
    local h = ch:FindFirstChild("HumanoidRootPart")
    if not h then return end
    if #W >= CFG.Max then return end
    local p = h.Position
    table.insert(W, {x = p.X, y = p.Y, z = p.Z, name = "WP " .. (#W + 1)})
    saveW()
    _G.refreshWaypoints()
end)

