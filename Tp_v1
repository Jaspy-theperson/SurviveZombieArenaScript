    nl.BackgroundTransparency = 1
    nl.Text = w.name or ("WP " .. i)
    nl.TextColor3 = Color3.fromRGB(230, 230, 255)
    nl.TextSize = 13
    nl.Font = Enum.Font.GothamBold
    nl.TextXAlignment = Enum.TextXAlignment.Left
    nl.Parent = r

    local co = Instance.new("TextLabel")
