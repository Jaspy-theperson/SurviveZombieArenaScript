local ddOpen = false
local tundraOpen = false

local function recalcLayout()
    local coveHeight = 0
    if ddOpen then coveHeight = 92 end
    
    local tundraHeight = 0
    if tundraOpen then tundraHeight = 92 end
    
    local info = TweenInfo.new(0.2)
    
    TweenService:Create(coveSubtitle, info, {
        Position = UDim2.new(0, 0, 0, COVE_SUB_TOP + coveHeight)
    }):Play()
    
    TweenService:Create(tundraContainer, info, {
        Position = UDim2.new(0, 0, 0, TUNDRA_TOP + coveHeight)
    }):Play()
    
    TweenService:Create(tundraSubtitle, info, {
        Position = UDim2.new(0, 0, 0, TUNDRA_SUB_TOP + coveHeight + tundraHeight)
    }):Play()
    
    TweenService:Create(belowContainer, info, {
        Position = UDim2.new(0, 0, 0, BELOW_TOP + coveHeight + tundraHeight)
    }):Play()
end

