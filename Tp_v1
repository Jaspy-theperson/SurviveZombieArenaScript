local W = {}

local function loadW()
    if writefile and readfile and isfile and isfile(CFG.SaveFile) then
        local s, d = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(CFG.SaveFile))
        end)
        if s and type(d) == "table" then W = d end
    end
end

local function saveW()
    if writefile then
        local s, e = pcall(function()
            return game:GetService("HttpService"):JSONEncode(W)
        end)
        if s then pcall(writefile, CFG.SaveFile, e) end
    end
end

