local tabs = {}
local activeTab = nil

local function switchTab(n)
    for k, v in pairs(tabs) do v.Visible = (k == n) end
    activeTab = n
end

local function createSidebarBtn(n)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 34)
    b.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
    b.Text = n
    b.TextColor3 = Color3.fromRGB(220, 220, 255)
    b.TextSize = 13
    b.Font = Enum.Font.GothamBold
    b.Parent = sb
    local bc = Instance.new("UICorner", b)
    bc.CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(function()
        switchTab(n)
        for _, ch in ipairs(sb:GetChildren()) do
            if ch:IsA("TextButton") then
                ch.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
            end
        end
        b.BackgroundColor3 = Color3.fromRGB(80, 80, 130)
    end)
    return b
end

local function createTab(n)
    local f = Instance.new("Frame")
    f.Name = n .. "Tab"
    f.Size = UDim2.new(1, -16, 1, -16)
    f.Position = UDim2.new(0, 8, 0, 8)
    f.BackgroundTransparency = 1
    f.Visible = false
    f.Parent = ca
    tabs[n] = f
    return f
end

local function tp(pos)
    local ch = player.Character
    if not ch then return end
    local h = ch:FindFirstChild("HumanoidRootPart")
        or ch:FindFirstChild("UpperTorso")
        or ch:FindFirstChild("Torso")
    if h then
        pcall(function() h.CFrame = CFrame.new(pos) end)
    end
end

