        ch.BackgroundColor3 = Color3.fromRGB(80, 80, 130)
    end
end

-- Toggle handlers
local function toggleUI() mf.Visible = not mf.Visible end
mb.MouseButton1Click:Connect(toggleUI)
mnb.MouseButton1Click:Connect(toggleUI)
cb.MouseButton1Click:Connect(function() mf.Visible = false end)

-- Coord tracker
task.spawn(function()
    while task.wait(0.1) do
        local ch = player.Character
        if ch then
            local h = ch:FindFirstChild("HumanoidRootPart")
            if h then
                local p = h.Position
                cl.Text = string.format("X: %.1f  Y: %.1f  Z: %.1f", p.X, p.Y, p.Z)
            end
        end
    end
end)

-- Keybinds
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == CFG.UIKey then
        toggleUI()
    elseif input.KeyCode == CFG.SAKey then
        tp(CFG.SA)
    elseif input.KeyCode == CFG.TUKey then
        tp(CFG.TU)
    end
end)

