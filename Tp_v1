local D1, D2 = false, false
local function recalc()
    local h1 = D1 and 92 or 0
    local h2 = D2 and 92 or 0
    local i = TweenInfo.new(0.2)
    TweenService:Create(cs, i, {Position = UDim2.new(0, 0, 0, 84 + h1)}):Play()
    TweenService:Create(dc2, i, {Position = UDim2.new(0, 0, 0, 148 + h1)}):Play()
    TweenService:Create(ts, i, {Position = UDim2.new(0, 0, 0, 192 + h1 + h2)}):Play()
end

dh1.MouseButton1Click:Connect(function()
    D1 = not D1
    if D1 then
        ct1.Visible = true
        ar1.Text = "▲"
        TweenService:Create(ct1, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 92)}):Play()
    else
        ar1.Text = "▼"
        local t = TweenService:Create(ct1, TweenInfo.new(0.15), {Size = UDim2.new(1, 0, 0, 0)})
        t:Play()
        t.Completed:Connect(function() if not D1 then ct1.Visible = false end end)
    end
    recalc()
end)

